# Server
PORT=8080
MONGO_URI=mongodb://localhost:27017/xylium

# Comma-separated list of tenant ids allowed to POST to /collect
ALLOWED_TENANTS=acme_corp

# Comma-separated list of allowed browser origins for CORS (use * only in dev)
CORS_ORIGINS=https://app.acme-corp.example.com

# JSON map of tenantId -> secret API key. Only the tenant's OWN backend
# should ever hold the raw key on the right-hand side — it is sent as the
# x-api-key header when calling POST /identify.
# Generate each key with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TENANT_API_KEYS={"acme_corp":"replace-with-a-long-random-secret"}

# Payload / batching limits
MAX_BATCH_EVENTS=500
MAX_PAYLOAD_BYTES=262144

# Raw event retention (0 = keep forever)
RAW_TTL_DAYS=0

# Rate limiting (applies per IP, across both /collect and /identify)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=3000
