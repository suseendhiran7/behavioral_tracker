# ---- HTTP ----
PORT=8080

# ---- Dual Database Architecture (PostgreSQL + MongoDB) ----
ACTIVE_DATABASE=mongodb
# Allowed: mongodb | postgresql

# ---- Mongo ----
MONGO_URI=mongodb://localhost:27017/xylium
MONGODB_DATABASE=xylium
MONGO_MAX_POOL=20
MONGO_TIMEOUT_MS=5000

# ---- PostgreSQL ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=behavioral_events
POSTGRES_USER=app_user
POSTGRES_PASSWORD=
POSTGRES_SSL=false
POSTGRES_MAX_POOL=20
POSTGRES_IDLE_TIMEOUT_MS=30000
POSTGRES_CONNECTION_TIMEOUT_MS=5000

# ---- Redis (BullMQ queue for forwarding) ----
REDIS_HOST=localhost
REDIS_PORT=6379

# ---- Forward target: your existing FastAPI feature/scoring service ----
FASTAPI_INGEST_URL=http://localhost:8000/ingest

# ---- Multi-tenant allowlist ----
# Only these tenantIds are accepted at /collect. Comma-separated. Leave empty to allow all (dev only).
ALLOWED_TENANTS=tenant_test001,tenant_abc123

# ---- CORS ----
# Origins allowed to call /collect from the browser. Comma-separated. "*" for local testing only.
CORS_ORIGINS=*

# ---- Server-to-server /identify auth ----
# JSON map of tenantId -> secret key, used by the customer's LOGIN BACKEND.
TENANT_API_KEYS={"tenant_test001":"changeme-secret","tenant_abc123":"changeme-secret"}

# ---- Limits / hardening ----
MAX_BATCH_EVENTS=500
MAX_PAYLOAD_BYTES=262144
# raw batch retention in days; 0 = keep forever (TTL index disabled)
RAW_TTL_DAYS=30

# ---- Rate limiting ----
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=3000
