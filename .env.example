# Server
PORT=8080

# ---- Dual Database Architecture (PostgreSQL + MongoDB) ----
ACTIVE_DATABASE=mongodb
# Allowed: mongodb | postgresql

# ---- Mongo ----
MONGO_URI=mongodb://localhost:27017/xylium
MONGODB_DATABASE=xylium
MONGO_MAX_POOL=20
MONGO_TIMEOUT_MS=5000

# ---- PostgreSQL ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=behavioral_events
POSTGRES_USER=app_user
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_SSL=false
POSTGRES_MAX_POOL=20
POSTGRES_IDLE_TIMEOUT_MS=30000
POSTGRES_CONNECTION_TIMEOUT_MS=5000

# Comma-separated list of tenant ids allowed to POST to /collect
ALLOWED_TENANTS=acme_corp

# Comma-separated list of allowed browser origins for CORS (use * only in dev)
CORS_ORIGINS=https://app.acme-corp.example.com

# JSON map of tenantId -> secret API key. Only the tenant's OWN backend
# should ever hold the raw key on the right-hand side — it is sent as the
# x-api-key header when calling POST /identify.
# Generate each key with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TENANT_API_KEYS={"acme_corp":"replace-with-a-long-random-secret"}

# Payload / batching limits
MAX_BATCH_EVENTS=500
MAX_PAYLOAD_BYTES=262144

# Raw event retention (0 = keep forever)
RAW_TTL_DAYS=0

# Rate limiting (applies per IP, across both /collect and /identify)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=3000

XYLIUM_SDK_DIR=


# ---- Event routing ----
# Logged-in events on pages whose path matches this regex go to payment_events
PAYMENT_PAGE_PATTERN=(payment|checkout|pay|billing)

# ---- SDK files ----
# XYLIUM_SDK_DIR=D:\xylium\project\behavioral_tracker\sdk

# ---- Reverse proxy ----
# Which proxies may set X-Forwarded-For. Default: loopback, linklocal, uniquelocal.
# Use a hop count (e.g. 1) or CIDR list for cloud LBs. NEVER "true" on a public-facing app.
# TRUST_PROXY=loopback, linklocal, uniquelocal

# ---- IP intelligence (/ip-intel: VPN / proxy / datacenter / country) ----
# none  = endpoint returns nulls
# ipqs  = IPQualityScore (production; needs IPQS_API_KEY)
# ipapi = ip-api.com (local dev only: non-commercial, HTTP, ~45 req/min)
IP_INTEL_PROVIDER=ipapi
IPQS_API_KEY=
IPQS_STRICTNESS=1
IP_INTEL_TIMEOUT_MS=3000
IP_INTEL_CACHE_TTL_MS=21600000
IP_INTEL_CACHE_MAX=10000
IP_INTEL_RATE_LIMIT_WINDOW_MS=60000
IP_INTEL_RATE_LIMIT_MAX=30
# Dev only: localhost can't be classified, so look up this public IP instead.
# Ignored when NODE_ENV=production. Example: 8.8.8.8
IP_INTEL_DEV_IP=

