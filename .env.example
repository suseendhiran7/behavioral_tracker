
# ---- HTTP ----
PORT=8080
NODE_ENV=development

# ---- Mongo ----
MONGO_URI=mongodb://localhost:27017/xylium
# MONGODB_DATABASE=xylium
# MONGO_MAX_POOL=20
# MONGO_MIN_POOL=2
# MONGO_TIMEOUT_MS=5000
# MONGO_SOCKET_TIMEOUT_MS=30000

# ---- PostgreSQL ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SSL=false
POSTGRES_MAX_POOL=20
# POSTGRES_IDLE_TIMEOUT_MS=30000
# POSTGRES_CONNECTION_TIMEOUT_MS=5000

ACTIVE_DATABASE=postgresql

# ---- PostgreSQL event tables (login_events / session_events / payment_events) ----
# One row per SDK event, one column per SDK field (no JSON). Tables are created on connect.
# A field with no column yet (new SDK pattern, custom track() props) gets a column automatically.
# PG_EVENT_AUTO_COLUMNS=true
# Safety cap on columns per table (PostgreSQL's hard limit is 1600).
# PG_EVENT_MAX_COLUMNS=1200

# ---- Redis (BullMQ queue for forwarding) ----
REDIS_HOST=localhost
REDIS_PORT=6379

# ---- Forward target: FastAPI feature/scoring service ----
FASTAPI_INGEST_URL=http://localhost:8000/ingest

# ---- Multi-tenant allowlist ----
# Only these tenantIds are accepted at /collect and /ip-intel. Empty = allow all (dev only).
ALLOWED_TENANTS=tenant_test001,tenant_abc123

# ---- CORS ----
CORS_ORIGINS=*

# ---- Server-to-server /identify auth ----
TENANT_API_KEYS={"tenant_test001":"changeme-secret","tenant_abc123":"changeme-secret"}

# ---- Auth (JWT for /api/events) ----
# Change this in production (32+ random characters).
JWT_SECRET=change-me-to-a-long-random-secret-32chars

# ---- Limits / hardening ----
MAX_BATCH_EVENTS=500
MAX_PAYLOAD_BYTES=262144
# Raw event retention in days; 0 = keep forever
RAW_TTL_DAYS=30

# ---- Rate limiting ----
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=3000

# ---- Event routing ----
# Logged-in events on pages whose path matches this regex go to payment_events
PAYMENT_PAGE_PATTERN=(payment|checkout|pay|billing)

# ---- SDK files ----
# XYLIUM_SDK_DIR=D:\xylium\project\behavioral_tracker\sdk

# ---- Reverse proxy ----
# Which proxies may set X-Forwarded-For. Default: loopback, linklocal, uniquelocal.
# Use a hop count (e.g. 1) or CIDR list for cloud LBs. NEVER "true" on a public-facing app.
# TRUST_PROXY=loopback, linklocal, uniquelocal

# ---- IP intelligence (/ip-intel: VPN / proxy / datacenter / country) ----
# none  = endpoint returns nulls
# ipqs  = IPQualityScore (production; needs IPQS_API_KEY)
# ipapi = ip-api.com (local dev only: non-commercial, HTTP, ~45 req/min)
IP_INTEL_PROVIDER=ipapi
IPQS_API_KEY=
IPQS_STRICTNESS=1
IP_INTEL_TIMEOUT_MS=3000
IP_INTEL_CACHE_TTL_MS=21600000
IP_INTEL_CACHE_MAX=10000
IP_INTEL_RATE_LIMIT_WINDOW_MS=60000
IP_INTEL_RATE_LIMIT_MAX=30
# Dev only: localhost can't be classified, so look up this public IP instead.
# Ignored when NODE_ENV=production. Example: 8.8.8.8
IP_INTEL_DEV_IP=